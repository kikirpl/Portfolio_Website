---
interface Props {
  name: string;
  greeting: string | null;
}
const { name, greeting } = Astro.props;
---

<div class="loader" aria-hidden="true" data-loader>
  <div class="loader__inner">
    <p class="loader__line">
      {greeting && <span class="loader__greeting">{greeting} </span>}<span class="loader__name">{name}</span><span
        class="loader__caret"
      ></span>
    </p>
    <div class="loader__bar"><span class="loader__fill" data-loader-fill></span></div>
    <p class="loader__count data"><span data-loader-count>0</span>%</p>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
    place-items: center;
    background: var(--ink-0);
    transition:
      opacity 700ms var(--ease-out),
      visibility 0s linear 700ms;
  }

  :global(.mode-3d) .loader {
    display: grid;
  }

  .loader.is-done {
    opacity: 0;
    visibility: hidden;
  }

  /* If the page script never runs, the intro screen must not cover the page. */
  :global(.js:not(.js-ready)) .loader {
    animation: loader-failsafe 0s linear 4s forwards;
  }

  @keyframes loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .loader__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(26rem, 84vw);
  }

  .loader__line {
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-align: center;
  }

  .loader__name {
    color: var(--text-1);
  }

  .loader__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.2em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: caret 1.1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader__caret {
      animation: none;
    }
  }

  .loader__bar {
    width: 100%;
    height: 1px;
    overflow: hidden;
    background: var(--line);
  }

  .loader__fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    transition: transform 300ms var(--ease-out);
  }

  .loader__count {
    color: var(--text-3);
  }
</style>
