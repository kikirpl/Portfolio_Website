---
import { withBase, type Content } from '../data/content';

interface Props {
  profile: Content['profile'];
}

const { about, skills, photo } = Astro.props.profile;
const groups = skills.groups.filter((g) => g.items.length);
const srcset = (list: { src: string; width: number }[]) => list.map((s) => `${withBase(s.src)} ${s.width}w`).join(', ');
const sizes = '(min-width: 760px) 20rem, 64vw';
---

<section id="about" class="about section" data-section="about" aria-labelledby="about-title">
  <div class="panel about__panel" data-stop="about">
    <h2 id="about-title" class="section-title" tabindex="-1" data-reveal="wipe">{about.heading ?? 'About'}</h2>
    {
      photo && (
        <figure class="about__photo" data-reveal>
          <picture>
            <source type="image/avif" srcset={srcset(photo.sources.avif)} sizes={sizes} />
            <source type="image/webp" srcset={srcset(photo.sources.webp)} sizes={sizes} />
            <img
              src={withBase(photo.src)}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              style={`background-image:url(${photo.lqip})`}
            />
          </picture>
        </figure>
      )
    }
    <div class="about__text" data-reveal>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      groups.length > 0 && (
        <div class="skills" data-reveal>
          {skills.heading && <h3 class="skills__title">{skills.heading}</h3>}
          {groups.map((group) => (
            <div class="skills__group">
              {group.label && <h4 class="skills__label label">{group.label}</h4>}
              <ul class="skills__list">
                {group.items.map((item) => (
                  <li>{item.name}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    display: flex;
    align-items: center;
    min-height: 130svh;
    padding-block: 18svh;
  }

  .about__panel {
    max-width: 36rem;
  }

  @media (min-aspect-ratio: 17/20) {
    :global(.mode-3d main) .about__panel {
      margin-left: auto;
      margin-right: var(--rail-space);
      max-width: min(36rem, 38vw);
    }
  }

  /* In 3D the photo is a screen in the scene; the page shows it only in the 2D version. */
  .about__photo {
    display: none;
  }

  :global(.mode-2d) .about__photo,
  :global(.no-js) .about__photo {
    display: block;
    width: min(20rem, 100%);
    margin-top: 2.5rem;
    padding: 6px;
    background: var(--ink-2);
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.9),
      0 0 120px -50px var(--moon);
  }

  .about__photo img {
    width: 100%;
    border-radius: 3px;
    background-size: cover;
  }

  .about__text {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    margin-top: 2rem;
    max-width: 62ch;
    text-wrap: pretty;
  }

  .about__text p:first-child {
    color: var(--text-1);
  }

  .skills {
    display: grid;
    gap: 1.1rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .skills__title {
    color: var(--text-1);
    font-size: 1.125rem;
    font-weight: 640;
    font-stretch: 112%;
  }

  .skills__group {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .skills__label {
    color: var(--text-3);
  }

  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skills__list li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-1);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  :global(.mode-2d) .about,
  :global(.no-js) .about {
    min-height: auto;
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  :global(.mode-2d) .about__panel,
  :global(.no-js) .about__panel {
    max-width: 72rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-content: start;
    column-gap: clamp(2rem, 6vw, 6rem);
  }

  :global(.mode-2d) .about__panel > .section-title,
  :global(.no-js) .about__panel > .section-title {
    grid-column: 1;
    grid-row: 1;
  }

  :global(.mode-2d) .about__photo,
  :global(.no-js) .about__photo {
    grid-column: 1;
    grid-row: 2;
  }

  :global(.mode-2d) .about__text,
  :global(.no-js) .about__text {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
    margin-top: 0;
  }

  :global(.mode-2d) .skills,
  :global(.no-js) .skills {
    grid-column: 1;
    grid-row: 3;
    margin-top: 2.5rem;
  }

  @media (max-aspect-ratio: 17/20) {
    :global(.mode-3d) .about {
      align-items: flex-end;
      min-height: 150svh;
      padding-block: 42svh 12svh;
    }

    :global(.mode-3d) .about__panel {
      margin: 0;
    }
  }

  @media (max-width: 760px) {
    :global(.mode-2d) .about__panel,
    :global(.no-js) .about__panel {
      grid-template-columns: 1fr;
    }

    :global(.mode-2d) .about__panel > *,
    :global(.no-js) .about__panel > * {
      grid-column: auto;
      grid-row: auto;
    }

    :global(.mode-2d) .about__text,
    :global(.no-js) .about__text {
      margin-top: 2rem;
    }

    :global(.mode-2d) .about__photo,
    :global(.no-js) .about__photo {
      width: min(16rem, 64%);
      margin-top: 2rem;
    }

    .skills__group {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
